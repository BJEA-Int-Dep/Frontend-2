.custom-header {
  width: 100vw;
  min-width: 100vw;
  height: 180rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding-top: calc(env(safe-area-inset-top) + 44px);
  padding-bottom: 36rpx;
  background: #fff;
  box-sizing: border-box;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
  position: sticky;
  top: 0;
  z-index: 10;
}
.header-left, .header-right {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.header-center {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}
.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #222;
  text-align: center;
  line-height: 1.2;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  /* 渐变背景兼容性增强 */
  background: #667eea; /* 降级背景色 */
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  position: relative;
  padding: 100rpx 0 0 0;
  box-sizing: border-box;
  overflow-x: hidden;
  /* 设备适配 */
  -webkit-overflow-scrolling: touch;
  -webkit-tap-highlight-color: transparent;
}

.welcome-section {
  text-align: center;
  margin-bottom: 60rpx;
  padding: 0 40rpx;
  position: relative;
}

@keyframes bounce {
  0%, 20%, 50%, 80%, 100% {
    transform: translateY(0);
  }
  40% {
    transform: translateY(-10rpx);
  }
  60% {
    transform: translateY(-5rpx);
  }
}

.welcome-text {
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  margin-bottom: 20rpx;
  /* 文字阴影兼容性增强 */
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.3);
  letter-spacing: 2rpx;
  /* 防止文字溢出 */
  word-wrap: break-word;
  overflow-wrap: break-word;
}

.welcome-subtitle {
  font-size: 30rpx;
  color: rgba(255,255,255,0.95);
  /* 文字阴影兼容性增强 */
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.2);
  font-weight: 400;
  letter-spacing: 1rpx;
  /* 防止文字溢出 */
  word-wrap: break-word;
  overflow-wrap: break-word;
}

.identity-tabs {
  width: 85%;
  max-width: 580rpx;
  display: flex;
  flex-direction: row;
  justify-content: center;
  margin: 0 auto 80rpx auto;
  background: rgba(255,255,255,0.12);
  border-radius: 60rpx;
  overflow: hidden;
  /* backdrop-filter兼容性增强 */
  backdrop-filter: blur(15rpx);
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.15);
  border: 1rpx solid rgba(255,255,255,0.25);
  position: relative;
  /* 设备适配 */
  -webkit-tap-highlight-color: transparent;
  -webkit-user-select: none;
  user-select: none;
}

.identity-tabs::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  /* 渐变背景兼容性增强 */
  background: rgba(255,255,255,0.1); /* 降级背景 */
  background: -webkit-linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
  background: -moz-linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
  background: -o-linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
  background: linear-gradient(135deg, rgba(255,255,255,0.1) 0%, rgba(255,255,255,0.05) 100%);
  border-radius: 60rpx;
  -webkit-border-radius: 60rpx;
  -moz-border-radius: 60rpx;
  pointer-events: none;
}

.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 36rpx 24rpx;
  font-size: 28rpx;
  color: rgba(255,255,255,0.7);
  background: transparent;
  /* 过渡动画兼容性增强 */
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  z-index: 1;
  /* 设备适配 */
  -webkit-tap-highlight-color: transparent;
}

.tab.active {
  color: #fff;
  background: rgba(255,255,255,0.25);
  font-weight: 600;
  /* 变换兼容性增强 */
  -webkit-transform: scale(1.02);
  -moz-transform: scale(1.02);
  -ms-transform: scale(1.02);
  -o-transform: scale(1.02);
  transform: scale(1.02);
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
  -webkit-box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
  -moz-box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

.tab-icon {
  font-size: 36rpx;
  margin-bottom: 10rpx;
  /* 过渡动画兼容性增强 */
  -webkit-transition: transform 0.3s ease;
  -moz-transition: transform 0.3s ease;
  -o-transition: transform 0.3s ease;
  transition: transform 0.3s ease;
  font-weight: bold;
  color: rgba(255,255,255,0.9);
  /* 字体渲染优化 */
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.tab.active .tab-icon {
  -webkit-transform: scale(1.1);
  -moz-transform: scale(1.1);
  -ms-transform: scale(1.1);
  -o-transform: scale(1.1);
  transform: scale(1.1);
  color: #fff;
}

.tab-text {
  font-size: 26rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.register-form {
  width: 88%;
  max-width: 680rpx;
  margin: 0 auto;
}

.form-content {
  background: rgba(255,255,255,0.98);
  border-radius: 36rpx;
  padding: 56rpx 48rpx;
  box-shadow: 0 24rpx 80rpx rgba(0,0,0,0.12);
  /* backdrop-filter兼容性增强 */
  backdrop-filter: blur(25rpx);
  border: 1rpx solid rgba(255,255,255,0.4);
  /* 动画兼容性增强 */
  animation: slideUp 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  /* 防止文字溢出 */
  word-wrap: break-word;
  overflow-wrap: break-word;
}

.form-content::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  /* 渐变背景兼容性增强 */
  background: #667eea; /* 降级背景色 */
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 36rpx 36rpx 0 0;
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 兼容性动画前缀 - 微信小程序优化版本 */

.form-header {
  display: flex;
  align-items: center;
  margin-bottom: 56rpx;
  padding-bottom: 28rpx;
  border-bottom: 2rpx solid rgba(102,126,234,0.1);
  position: relative;
}

.form-header::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 0;
  width: 60rpx;
  height: 4rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 2rpx;
}

.form-title-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0,0,0,0.1));
  color: #667eea;
  font-weight: bold;
}

.form-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  letter-spacing: 1rpx;
}

.input-group {
  display: flex;
  align-items: center;
  background: rgba(248,249,250,0.8);
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 36rpx;
  border: 2rpx solid transparent;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(10rpx);
}

.input-group::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(102,126,234,0.02) 0%, rgba(118,75,162,0.02) 100%);
  border-radius: 24rpx;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.input-group:focus-within {
  border-color: #667eea;
  background: rgba(255,255,255,0.95);
  box-shadow: 0 8rpx 32rpx rgba(102,126,234,0.2);
  transform: translateY(-3rpx);
}

.input-group:focus-within::before {
  opacity: 1;
}

.input-icon {
  font-size: 24rpx;
  margin-right: 20rpx;
  color: #667eea;
  flex-shrink: 0;
  font-weight: bold;
  background: rgba(102,126,234,0.1);
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  min-width: 44rpx;
  text-align: center;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.input-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.label {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 48rpx;
  line-height: 48rpx;
  font-size: 32rpx;
  color: #333;
  border: none;
  background: transparent;
  padding: 0;
  box-sizing: border-box;
}

.input::placeholder {
  color: #999;
}

.register-btn {
  width: 100%;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 50rpx;
  margin-top: 48rpx;
  box-shadow: 0 12rpx 32rpx rgba(102,126,234,0.3);
  transition: all 0.3s ease;
  border: none;
  position: relative;
  overflow: hidden;
}

.register-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
  transition: left 0.5s;
}

.register-btn:active::before {
  left: 100%;
}

.register-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 8rpx 24rpx rgba(102,126,234,0.4);
}

.register-btn.loading {
  background: linear-gradient(135deg, #9ca3af 0%, #6b7280 100%);
  pointer-events: none;
}

.loading-icon {
  width: 32rpx;
  height: 32rpx;
  border: 3rpx solid rgba(255,255,255,0.3);
  border-top: 3rpx solid #fff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-right: 16rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.register-bottom {
  position: relative;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0 calc(env(safe-area-inset-bottom) + 12rpx) 0;
  margin-top: 40rpx;
}

.register-text {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 16rpx 32rpx;
}

.register-prompt {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  font-weight: 400;
}

.link {
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s ease;
  position: relative;
}

.link::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 0;
  width: 0;
  height: 2rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  transition: width 0.3s ease;
}

.link:active {
  color: rgba(255,255,255,0.8);
  transform: scale(0.95);
}

.link:active::after {
  width: 100%;
} 